{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" != \"main\"",
  "buildCommand": "npm run prisma:deploy -w server && npm run prisma:generate -w server && npm run build -w server && npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/widgets/:widgetId/blocks/reorder",
      "destination": "/api/widgets-resource?resource=widget&widgetId=:widgetId&action=blocks"
    },
    {
      "source": "/api/widgets/:widgetId/blocks",
      "destination": "/api/widgets-resource?resource=widget&widgetId=:widgetId&action=blocks"
    },
    {
      "source": "/api/widgets/:widgetId/preview",
      "destination": "/api/widgets-resource?resource=widget&widgetId=:widgetId&action=preview"
    },
    {
      "source": "/api/widgets/:widgetId",
      "destination": "/api/widgets-resource?resource=widget&widgetId=:widgetId"
    },
    {
      "source": "/api/blocks/:blockId",
      "destination": "/api/widgets-resource?resource=block&blockId=:blockId"
    },
    {
      "source": "/api/public/widgets/:slug",
      "destination": "/api/widgets-resource?resource=public&slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
